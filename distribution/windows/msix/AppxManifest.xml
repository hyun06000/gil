<?xml version="1.0" encoding="utf-8"?>
<!--
  GIL — Microsoft Store package manifest (template).

  build-msix.ps1 substitutes the {{...}} placeholders. Identity values come from Partner Center
  (reserve the app name, then copy "Package/Identity/Name", "Package/Identity/Publisher" and
  "Package/Properties/PublisherDisplayName" from Product management → Product identity).
  A dev identity (CN=GIL Dev) is used only for the signed sideload check in CI.

  Why each capability is declared (also the text for the Store certification notes):
  - runFullTrust: gil.exe is a Win32 console program (the GIL Core and its MCP stdio server),
    packaged as MSIX. It opens no window; agent Hosts start it as a child process.
  - unvirtualizedResources + FileSystemWriteVirtualization/RegistryWriteVirtualization disabled:
    `gil install` must write the user's real Claude Desktop and Codex settings
    (%APPDATA%\Claude\claude_desktop_config.json, %USERPROFILE%\.codex\config.toml) so those
    separate apps can read the entry. Writes stay in the user's own profile; nothing touches
    HKLM or other users.
  - windows.appExecutionAlias "gil.exe": a stable path (%LOCALAPPDATA%\Microsoft\WindowsApps\gil.exe)
    that Claude Desktop and Codex register as the MCP server command.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 desktop4 desktop6 rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <!-- Must equal a name reserved in Partner Center for this app (reserved 2026-11-13: gil-companion). -->
    <DisplayName>gil-companion</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>GIL Core and MCP server for Claude Desktop and Codex. Run `gil install` once to register it; the Monitor appears inside the agent Host.</Description>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ko-kr" />
    <Resource Language="ja-jp" />
    <Resource Language="zh-cn" />
    <Resource Language="zh-tw" />
  </Resources>

  <Applications>
    <Application Id="GIL"
      Executable="gil.exe"
      EntryPoint="Windows.FullTrustApplication"
      desktop4:Subsystem="console"
      desktop4:SupportsMultipleInstances="true"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="gil-companion"
        Description="GIL Core and MCP server. Open a terminal and run: gil install"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="gil.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="gil.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
