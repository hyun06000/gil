{
  "name": "Case 6 — the app disconnects during an approval request or the user does not answer: operational waiting, never auto-approval",
  "preset": "fresh_interview",
  "options": { "product_safety": true },
  "steps": [
    { "event": "open_step", "args": { "kind": "question", "contract": { "objective": "learn the goal", "next_action": "ask", "done_when": "the user's answer is recorded" } } },
    { "event": "close_step", "args": { "report": { "question": "what is the goal?", "response": "(agent guess)" } }, "expect": { "refused": "ResponseNotFromHuman" } },
    { "event": "human_answer", "args": {} },
    { "event": "close_step", "args": { "report": { "question": "what is the goal?", "response": "ship X" } } },
    { "event": "open_step", "args": { "kind": "interpretation", "contract": { "objective": "interpret", "next_action": "state it", "done_when": "written" } } },
    { "event": "close_step", "args": { "report": { "interpretation": "the user wants X shipped" } } },
    { "event": "open_step", "args": { "kind": "synthesis", "contract": { "objective": "propose the plan", "next_action": "present it and wait for the button", "done_when": "the human has decided on this exact revision" } } },
    { "event": "close_step", "args": { "report": { "statement": "do A, B", "approved": "yes", "digest": "d1" } }, "expect": { "refused": "ApprovalNotFromHuman" } },
    { "event": "propose_plan", "args": { "digest": "d1", "items": ["A", "B"] }, "assert": { "plan.proposals.0.receipt": null } },
    { "event": "session_crash", "args": {} },
    { "event": "session_resume", "args": {}, "assert": { "plan.proposals.0.receipt": null, "cycles.1.steps.3.status": "open", "active_will.target.step": 3 } },
    { "event": "close_step", "args": { "report": { "statement": "do A, B", "approved": "yes", "digest": "d1" } }, "expect": { "refused": "ApprovalNotFromHuman" } },
    { "event": "human_decide", "args": { "digest": "wrong", "decision": "approve" }, "expect": { "refused": "DigestMismatch" } },
    { "event": "human_decide", "args": { "digest": "d1", "decision": "approve" }, "assert": { "plan.proposals.0.receipt.decision": "approve" } },
    { "event": "human_decide", "args": { "digest": "d1", "decision": "approve" }, "expect": { "refused": "AlreadyDecided" } },
    { "event": "close_step", "args": { "report": { "statement": "do A, B", "approved": "yes", "digest": "other" } }, "expect": { "refused": "ApprovalForOtherProposal" } },
    { "event": "propose_plan", "args": { "digest": "d1b", "items": ["A", "B", "C"] }, "assert": { "plan.proposals.0.superseded": true, "plan.proposals.1.receipt": null } },
    { "event": "close_step", "args": { "report": { "statement": "do A, B, C", "approved": "yes", "digest": "d1b" } }, "expect": { "refused": "ApprovalNotFromHuman" } },
    { "event": "human_decide", "args": { "digest": "d1b", "decision": "request_changes" } },
    { "event": "close_step", "args": { "report": { "statement": "do A, B, C", "approved": "yes", "digest": "d1b" } }, "expect": { "refused": "ApprovalNotFromHuman" } },
    { "event": "close_step", "args": { "report": { "statement": "do A, B, C", "approved": "no", "digest": "d1b" } }, "assert": { "cycles.1.steps.3.status": "closed" } },
    { "event": "open_step", "args": { "kind": "question", "contract": { "objective": "learn why not", "next_action": "ask", "done_when": "the user's answer is recorded" } } },
    { "event": "human_answer", "args": {} },
    { "event": "close_step", "args": { "report": { "question": "what should change?", "response": "drop C" } } },
    { "event": "open_step", "args": { "kind": "interpretation", "contract": { "objective": "interpret", "next_action": "state it", "done_when": "written" } } },
    { "event": "close_step", "args": { "report": { "interpretation": "C is out of scope" } } },
    { "event": "open_step", "args": { "kind": "synthesis", "contract": { "objective": "propose again", "next_action": "present and wait", "done_when": "decided" } } },
    { "event": "propose_plan", "args": { "digest": "d2", "items": ["A", "B"] } },
    { "event": "human_decide", "args": { "digest": "d2", "decision": "approve" } },
    { "event": "close_step", "args": { "report": { "statement": "do A, B", "approved": "yes", "digest": "d2" } } },
    { "event": "open_step", "args": { "kind": "outcome", "contract": { "objective": "close the interview", "next_action": "record success", "done_when": "written" } } },
    { "event": "close_step", "args": { "report": { "verdict": "success", "lesson": "scope agreed", "next_direction.action": "close_cycle", "next_direction.reason": "approved", "synthesis_ref": "step:C1/S6" } } },
    { "event": "close_cycle", "args": { "report": { "verdict": "success", "outcome_ref": "step:C1/S7", "handoff_summary": "A, B approved on revision 3", "next_direction.action": "open_child", "next_direction.reason": "start A" } } },
    { "event": "open_cycle", "args": { "kind": "experiment" }, "assert": { "plan.executions.0.item": "A", "plan.executions.0.revision": 3 } }
  ]
}
