{
  "$comment": "Each scenario ends in a refusal the proposal requires. A refused event must leave the state byte-identical.",
  "scenarios": [
    { "name": "F01 empty evidence", "preset": "approved_plan_ready", "steps": [
      { "macro": "open_experiment" }, { "macro": "define_hypothesis_open_verify" }, { "macro": "partial_edit" },
      { "event": "close_verify", "args": { "report": { "execution": "ran", "result": "saw" } }, "expect": { "refused": "EvidenceMissing" } } ] },
    { "name": "F02 unchanged evidence", "preset": "approved_plan_ready", "steps": [
      { "macro": "open_experiment" }, { "macro": "define_hypothesis_open_verify" }, { "macro": "partial_edit" },
      { "event": "close_verify", "args": { "report": { "execution": "ran", "result": "saw", "evidence_files": "README.md" } }, "expect": { "refused": "EvidenceStale" } } ] },
    { "name": "F03 evidence not in world", "preset": "approved_plan_ready", "steps": [
      { "macro": "open_experiment" }, { "macro": "define_hypothesis_open_verify" },
      { "event": "close_verify", "args": { "report": { "execution": "ran", "result": "saw", "evidence_files": "evidence/none.md" } }, "expect": { "refused": "EvidenceNotInWorld" } } ] },
    { "name": "F04 empty evidence file", "preset": "approved_plan_ready", "steps": [
      { "macro": "open_experiment" }, { "macro": "define_hypothesis_open_verify" },
      { "event": "edit_files", "args": { "files": { "README.md": "r1", "evidence/empty.md": "" } } },
      { "event": "close_verify", "args": { "report": { "execution": "ran", "result": "saw", "evidence_files": "evidence/empty.md" } }, "expect": { "refused": "EvidenceEmptyFile" } } ] },
    { "name": "F05 observation refused (symlink/permission): Verify stays open, no domain transition", "preset": "approved_plan_ready", "steps": [
      { "macro": "open_experiment" }, { "macro": "define_hypothesis_open_verify" }, { "macro": "partial_edit" },
      { "event": "close_verify", "args": { "observation_refused": true, "report": { "execution": "ran", "result": "saw", "evidence_files": "src/partial.py" } }, "expect": { "refused": "ObservationRefused" } } ] },
    { "name": "F06 success + not_reached is a fake success", "preset": "approved_plan_ready", "steps": [
      { "macro": "open_experiment" }, { "macro": "define_hypothesis_open_verify" }, { "macro": "partial_edit" }, { "macro": "narrow_and_close_verify" },
      { "event": "open_step", "args": { "kind": "analysis", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } } },
      { "event": "close_step", "args": { "report": { "interpretation": "inconclusive" } } },
      { "event": "open_step", "args": { "kind": "outcome", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } } },
      { "event": "close_step", "args": { "report": { "verdict": "success", "conclusion": "not_reached", "blocker": "x", "lesson": "l", "next_direction.action": "close_cycle", "next_direction.reason": "r" } }, "expect": { "refused": "ConclusionRefused" } },
      { "event": "close_step", "args": { "report": { "verdict": "failure", "conclusion": "not_reached", "lesson": "l", "next_direction.action": "close_cycle", "next_direction.reason": "r" } }, "expect": { "refused": "BlockerMissing" } },
      { "event": "close_step", "args": { "report": { "verdict": "Success", "lesson": "l", "next_direction.action": "close_cycle", "next_direction.reason": "r" } }, "expect": { "refused": "VerdictValueRefused" } },
      { "event": "close_step", "args": { "report": { "verdict": "success", "lesson": "l", "next_direction.action": "revisit", "next_direction.reason": "r" } }, "expect": { "refused": "ActionNotAllowed" } },
      { "event": "close_step", "args": { "report": { "verdict": "failure", "conclusion": "maybe", "lesson": "l", "next_direction.action": "close_cycle", "next_direction.reason": "r" } }, "expect": { "refused": "ConclusionRefused" } } ] },
    { "name": "F07 cycle report must repeat the outcome's verdict and conclusion", "preset": "approved_plan_ready", "steps": [
      { "macro": "open_experiment" }, { "macro": "define_hypothesis_open_verify" }, { "macro": "partial_edit" }, { "macro": "narrow_and_close_verify" }, { "macro": "analysis_outcome_not_reached" },
      { "event": "close_cycle", "args": { "report": { "verdict": "success", "conclusion": "not_reached", "outcome_ref": "step:C2/S5", "handoff_summary": "h", "next_direction.action": "open_child", "next_direction.reason": "r" } }, "expect": { "refused": "VerdictMismatch" } },
      { "event": "close_cycle", "args": { "report": { "verdict": "failure", "outcome_ref": "step:C2/S5", "handoff_summary": "h", "next_direction.action": "revisit", "next_direction.target_cycle_ref": "cycle:C1", "next_direction.reason": "r" } }, "expect": { "refused": "ConclusionMismatch" } },
      { "event": "close_cycle", "args": { "report": { "verdict": "failure", "conclusion": "not_reached", "outcome_ref": "step:C2/S5", "handoff_summary": "h", "next_direction.action": "revisit", "next_direction.reason": "r" } }, "expect": { "refused": "TargetRequiredOrForbidden" } },
      { "event": "close_cycle", "args": { "report": { "verdict": "failure", "conclusion": "not_reached", "outcome_ref": "step:C2/S5", "handoff_summary": "h", "next_direction.action": "open_child", "next_direction.target_cycle_ref": "cycle:C1", "next_direction.reason": "r" } }, "expect": { "refused": "TargetRequiredOrForbidden" } },
      { "event": "close_cycle", "args": { "report": { "verdict": "failure", "conclusion": "not_reached", "outcome_ref": "step:C2/S5", "handoff_summary": "h", "next_direction.action": "revisit", "next_direction.target_cycle_ref": "cycle:C2", "next_direction.reason": "r" } }, "expect": { "refused": "RevisitTargetRefused" } } ] },
    { "name": "F08 revisit never starts from an open node, a dirty world or product-safety", "preset": "approved_plan_ready", "options": { "product_safety": false }, "steps": [
      { "macro": "open_experiment" },
      { "event": "revisit_cycle", "args": {}, "expect": { "refused": "CycleStillOpen" } },
      { "macro": "define_hypothesis_open_verify" },
      { "event": "revisit_cycle", "args": {}, "expect": { "refused": "CycleStillOpen" } },
      { "event": "edit_files", "args": { "files": { "README.md": "r1", "evidence/result.md": "f1" } } },
      { "event": "close_verify", "args": { "report": { "execution": "ran", "result": "failed", "evidence_files": "evidence/result.md" } } },
      { "macro": "analysis_outcome_judged_failure" },
      { "event": "close_cycle", "args": { "report": { "verdict": "failure", "outcome_ref": "step:C2/S5", "handoff_summary": "h", "next_direction.action": "revisit", "next_direction.target_cycle_ref": "cycle:C1", "next_direction.reason": "r" } } },
      { "event": "edit_files", "args": { "files": { "README.md": "r1", "evidence/result.md": "f1", "scratch.txt": "s" } } },
      { "event": "revisit_cycle", "args": {}, "expect": { "refused": "DirtyWorld" } },
      { "event": "edit_files", "args": { "files": { "README.md": "r1", "evidence/result.md": "f1" } } },
      { "event": "revisit_cycle", "args": {}, "assert": { "pending_cycle_revisit": 2, "current_cycle": 1 } },
      { "event": "revisit_cycle", "args": {}, "expect": { "refused": "RevisitPending" } },
      { "event": "open_step", "args": { "kind": "question", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } }, "expect": { "refused": "RevisitPending" } },
      { "event": "open_cycle", "args": { "kind": "experiment" }, "assert": { "cycles.3.revisit_from": 2, "plan.executions.1.item": "B" } } ] },
    { "name": "F09 no revisit declared; nothing open to close; existing cycle already closed", "preset": "approved_plan_ready", "steps": [
      { "event": "revisit_cycle", "args": {}, "expect": { "refused": "NoRevisitDeclared" } },
      { "event": "close_cycle", "args": { "report": { "verdict": "success", "outcome_ref": "step:C1/S4", "handoff_summary": "h", "next_direction.action": "open_child", "next_direction.reason": "r" } }, "expect": { "refused": "CycleNotOpen" } },
      { "event": "open_step", "args": { "kind": "define", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } }, "expect": { "refused": "NoOpenCycle" } },
      { "event": "human_answer", "args": {}, "expect": { "refused": "NoOpenQuestion" } },
      { "event": "propose_plan", "args": { "digest": "x", "items": [] }, "expect": { "refused": "NoOpenSynthesis" } },
      { "event": "human_decide", "args": { "digest": "x", "decision": "approve" }, "expect": { "refused": "NoProposal" } },
      { "event": "revise_will", "args": { "next_action": "n" }, "expect": { "refused": "NoActiveWill" } },
      { "event": "restore_world", "args": {}, "expect": { "refused": "ProductSafetyBlocked" } } ] },
    { "name": "F10 single open cycle, single open step, atomic contract, grammar", "preset": "approved_plan_ready", "steps": [
      { "macro": "open_experiment" },
      { "event": "open_cycle", "args": { "kind": "experiment" }, "expect": { "refused": "AnotherCycleOpen" } },
      { "event": "close_step", "args": { "report": {} }, "expect": { "refused": "NothingOpen" } },
      { "event": "close_cycle", "args": { "report": { "verdict": "failure", "outcome_ref": "step:C2/S5", "handoff_summary": "h", "next_direction.action": "revisit", "next_direction.target_cycle_ref": "cycle:C1", "next_direction.reason": "r" } }, "expect": { "refused": "ReportIncomplete" } },
      { "event": "open_step", "args": { "kind": "define", "contract": { "objective": "o", "next_action": "", "done_when": "d" } }, "expect": { "refused": "ContractIncomplete" } },
      { "event": "open_step", "args": { "kind": "verify", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } }, "expect": { "refused": "GrammarRefused" } },
      { "event": "open_step", "args": { "kind": "define", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } } },
      { "event": "open_step", "args": { "kind": "hypothesis", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } }, "expect": { "refused": "StepStillOpen" } },
      { "event": "revise_will", "args": { "target": { "cycle": 2, "step": 9 }, "next_action": "n" }, "expect": { "refused": "WillTargetLocked" } },
      { "event": "revise_will", "args": { "done_when": "  " }, "expect": { "refused": "ContractIncomplete" } },
      { "event": "close_verify", "args": { "report": { "execution": "e", "result": "r", "evidence_files": "README.md" } }, "expect": { "refused": "NotVerify" } },
      { "event": "edit_files", "args": { "files": { "README.md": "r1", "stray.txt": "x" } } },
      { "event": "close_step", "args": { "report": { "problem": "p", "success_condition": "s" } }, "expect": { "refused": "DirtyWorld" } },
      { "event": "edit_files", "args": { "files": { "README.md": "r1" } } },
      { "event": "close_step", "args": { "report": { "problem": "p", "success_condition": "" } }, "expect": { "refused": "ReportIncomplete" } },
      { "event": "close_step", "args": { "report": { "problem": "p", "success_condition": "s" } } },
      { "event": "close_cycle", "args": { "report": { "verdict": "failure", "outcome_ref": "step:C2/S5", "handoff_summary": "h", "next_direction.action": "revisit", "next_direction.target_cycle_ref": "cycle:C1", "next_direction.reason": "r" } }, "expect": { "refused": "ReportIncomplete" } },
      { "event": "open_step", "args": { "kind": "hypothesis", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } } },
      { "event": "close_cycle", "args": { "report": { "verdict": "failure", "outcome_ref": "step:C2/S5", "handoff_summary": "h", "next_direction.action": "revisit", "next_direction.target_cycle_ref": "cycle:C1", "next_direction.reason": "r" } }, "expect": { "refused": "InnerStepStillOpen" } },
      { "event": "close_step", "args": { "report": { "hypothesis": "h", "rationale": "r", "guardrail": "g" } } },
      { "event": "open_step", "args": { "kind": "verify", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } } },
      { "event": "close_step", "args": { "report": { "execution": "e", "result": "r", "evidence_files": "README.md" } }, "expect": { "refused": "IsVerify" } },
      { "event": "request_interview", "args": { "reason": "   " }, "expect": { "refused": "ReasonEmpty" } } ] },
    { "name": "F11 no pending item left means an Interview, never an unapproved experiment", "preset": "approved_plan_ready", "options": { "items": ["A"] }, "steps": [
      { "macro": "open_experiment" }, { "macro": "define_hypothesis_open_verify" },
      { "event": "edit_files", "args": { "files": { "README.md": "r1", "evidence/result.md": "e1" } } },
      { "event": "close_verify", "args": { "report": { "execution": "e", "result": "pass", "evidence_files": "evidence/result.md" } } },
      { "macro": "analysis_outcome_success" },
      { "event": "close_cycle", "args": { "report": { "verdict": "success", "outcome_ref": "step:C2/S5", "handoff_summary": "h", "next_direction.action": "open_child", "next_direction.reason": "r" } } },
      { "event": "open_cycle", "args": { "kind": "experiment" }, "expect": { "refused": "NoPendingItem" } },
      { "event": "open_cycle", "args": { "kind": "interview" } },
      { "event": "request_interview", "args": { "reason": "x" }, "expect": { "refused": "NotInExperiment" } } ] },
    { "name": "F12 interview never closes as failure; unapproved synthesis cannot ground success (base mode without the ledger)", "preset": "fresh_interview", "options": { "approved_plan": false }, "steps": [
      { "event": "open_step", "args": { "kind": "question", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } } },
      { "event": "human_answer", "args": {} },
      { "event": "close_step", "args": { "report": { "question": "q", "response": "a" } } },
      { "event": "open_step", "args": { "kind": "interpretation", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } } },
      { "event": "close_step", "args": { "report": { "interpretation": "i" } } },
      { "event": "open_step", "args": { "kind": "synthesis", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } } },
      { "event": "close_step", "args": { "report": { "statement": "s", "approved": "yes" } }, "expect": { "refused": "ApprovalNotFromHuman" } },
      { "event": "human_answer", "args": { "approved": "no" } },
      { "event": "close_step", "args": { "report": { "statement": "s", "approved": "yes" } }, "expect": { "refused": "ApprovalNotFromHuman" } },
      { "event": "close_step", "args": { "report": { "statement": "s", "approved": "no" } } },
      { "event": "open_step", "args": { "kind": "outcome", "contract": { "objective": "o", "next_action": "n", "done_when": "d" } } },
      { "event": "close_step", "args": { "report": { "verdict": "failure", "lesson": "l", "next_direction.action": "close_cycle", "next_direction.reason": "r", "synthesis_ref": "step:C1/S3" } }, "expect": { "refused": "VerdictValueRefused" } },
      { "event": "close_step", "args": { "report": { "verdict": "success", "lesson": "l", "next_direction.action": "close_cycle", "next_direction.reason": "r", "synthesis_ref": "step:C1/S3" } }, "expect": { "refused": "SynthesisRefRefused" } } ] }
  ]
}
